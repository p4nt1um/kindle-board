# ~/.config/kindle-board/env —— 由 systemd --user 的 EnvironmentFile= 读取
# 使用前把路径里的 USER 换成实际用户名、YOUR-PI 换成设备主机名；模板刻意不含任何真实账户信息。
# 权限：chmod 600；本文件不得含任何 AK/SK / 口令（真实凭据在 secrets.json）
# 格式 KEY=VALUE：不要写 export、不要加引号、不要把注释写在同一行。
# 注意：这里刻意不出现任何 IP 地址 —— 树莓派地址由 DHCP 动态分配，
# 客户端用 kindle-board.local / YOUR-PI.local 发现服务。

NODE_ENV=production
PATH=/home/USER/.local/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 只指定网卡名，不指定 IP；换 WiFi / 换网段无需改这里
KINDLE_BOARD_IFACE=wlan0

# 凭据与代码分离：~/.config/kindle-board/secrets.json（目录 700 / 文件 600）
KINDLE_BOARD_SECRETS_FILE=/home/USER/.config/kindle-board/secrets.json

TZ=Asia/Shanghai

# 若 avahi-daemon 与内置 mDNS 应答器在 UDP 5353 冲突，取消下一行注释。
# 关掉的只是应答器，/api/discovery 与 IP 变化监听仍照常工作。
# KINDLE_BOARD_MDNS=off

# 不要在本文件放 API Key / 口令：所有凭据统一放 secrets.json
# （键名清单见项目根目录 secrets.example.json，例如 Kimi 是 "kimiKey"）。
# 改 secrets.json 会按 mtime 热加载、无需重启；改本文件则必须
# systemctl --user restart kindle-board.service 才会注入进程。
