# /etc/kindle-board/env  —— 由 systemd EnvironmentFile= 读取
# 权限：sudo chown root:root /etc/kindle-board/env && sudo chmod 600 /etc/kindle-board/env
#
# 格式是 KEY=VALUE，不要写 export、不要加引号、不要写注释在同一行。
# 空值等同于「未配置」；保留空行即可，不必删掉。
# 这些值只会留在服务端进程里，绝不进入 /api/board.json。

# ---- 平台相关（树莓派必看）----
# 网卡名：ip -br link 查看。WiFi 通常 wlan0，有线 eth0 / end0 / enpXsX。
# 不设也能跑（代码会自动扫物理网卡并跳过 docker/veth/tun 等虚拟网卡），
# 但设了能在 /api/discovery 里明确看到选中的网卡。
KINDLE_BOARD_IFACE=wlan0

# 若已执行 sudo hostnamectl set-hostname kindle-board，让 avahi-daemon 原生发布
# kindle-board.local，就关掉内置应答器，避免两个 responder 同时回答同一个名字。
# 关掉的只是 UDP 5353 应答，IP 发现与 /api/discovery 回退链照常工作。
# KINDLE_BOARD_MDNS=off

# 可选：把凭据文件移出应用目录（配合 npm run sync-secrets 使用）。
# 本文件已经能直接注入环境变量时，这一项不需要设。
# KINDLE_BOARD_SECRETS_FILE=/etc/kindle-board/secrets.json

# ---- AI 额度 ----
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
# 可选：换用自建/逆向端点时覆盖
KIMI_USAGE_ENDPOINT=
GLM_QUOTA_ENDPOINT=

# ---- 飞书 CalDAV 日程 ----
FEISHU_CALDAV_USERNAME=
FEISHU_CALDAV_PASSWORD=
FEISHU_CALDAV_URL=

# ---- 云账户余额（账号 AK/SK，建议只读子账号 / RAM 用户）----
# 百度智能云：https://cloud.baidu.com/doc/Finance/s/Skhtyytwu
#   接口 POST https://billing.baidubce.com/v1/finance/cash/balance
#   建议用 IAM 子用户 AK/SK（主账号需在 IAM 授财务读权限），不要用主账号 AK
#   2025-05-15 起明文 SK 只在创建时显示一次，查不到就新建一对
#   配完：npm run diagnose:baidu
BAIDU_CLOUD_AK=
BAIDU_CLOUD_SK=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
